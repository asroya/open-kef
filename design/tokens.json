{
  "$meta": {"name": "open-kef", "version": "0.1.0", "style": "typography-led editorial, menu-bar scale", "units": "pt"},
  "color": {
    "light": {"bg": "#FFFFFF", "surface": "#F7F7F7", "text": "#111111", "textMuted": "#6B6B6B", "line": "#E8E8E8", "accent": "#111111", "danger": "#C4321A"},
    "dark":  {"bg": "#161616", "surface": "#1E1E1E", "text": "#F2F2F2", "textMuted": "#9A9A9A", "line": "#2C2C2C", "accent": "#F2F2F2", "danger": "#FF6B4F"}
  },
  "font": {"family": "SF Pro (system)", "mono": "SF Mono (system)"},
  "type": {
    "title":   {"size": 15, "weight": 600, "tracking": -0.2, "lineHeight": 20},
    "body":    {"size": 13, "weight": 400, "tracking": 0,    "lineHeight": 18},
    "label":   {"size": 11, "weight": 500, "tracking": 0.2,  "lineHeight": 14},
    "numeric": {"size": 22, "weight": 600, "tracking": -0.4, "lineHeight": 26, "features": ["tnum"]}
  },
  "space": {"1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32},
  "radius": {"control": 6, "panel": 10, "art": 4},
  "size": {"panelWidth": 320, "rowHeight": 32, "art": 44, "iconHit": 28, "slider": 4},
  "motion": {"fast": 120, "base": 180, "easing": "easeOut"},
  "rules": [
    "One accent: monochrome. Colour only for danger/offline.",
    "Separate with space first, a 1pt line second, never a card.",
    "Numbers (volume) always tabular.",
    "No values outside this file."
  ]
}
